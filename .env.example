# API
PORT=3000
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3000

# sqlite | postgres | mysql
DB_TYPE=sqlite
DB_PATH=data/vanstack.sqlite

# PostgreSQL / MySQL (used when DB_TYPE is postgres or mysql)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=vanstack
DB_PASSWORD=vanstack
DB_NAME=vanstack

# OSS: local | s3
OSS_DRIVER=local
OSS_LOCAL_DIR=uploads
OSS_BUCKET=vanstack
OSS_REGION=us-east-1
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_ACCESS_KEY=vanstack
OSS_SECRET_KEY=vanstack_secret
OSS_PUBLIC_URL=

# i18n
FALLBACK_LANGUAGE=en

# Auth (JWT + seed admin). Replace placeholders before use.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me
