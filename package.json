{
  "name": "vanstack",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + React 19 TypeScript monorepo with i18n, XML, TypeORM, and OSS",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "minio": "cd minio && pnpm start:win",
    "dev": "pnpm --filter @vanstack/shared --filter @vanstack/xml --filter @vanstack/lowcode-runtime build && pnpm -r --parallel --filter @vanstack/shared --filter @vanstack/xml --filter @vanstack/lowcode-runtime --filter @vanstack/backend --filter @vanstack/frontend-editor-server --filter @vanstack/frontend-editor dev",
    "dev:backend": "pnpm --filter @vanstack/backend dev",
    "dev:editor": "pnpm --filter @vanstack/frontend-editor dev:standalone",
    "dev:editor-server": "pnpm --filter @vanstack/frontend-editor-server dev",
    "dev:desktop": "pnpm --filter @vanstack/shared --filter @vanstack/xml --filter @vanstack/lowcode-runtime build && pnpm -r --parallel --filter @vanstack/shared --filter @vanstack/xml --filter @vanstack/lowcode-runtime --filter @vanstack/backend --filter @vanstack/frontend-editor-server --filter @vanstack/frontend-editor --filter @vanstack/desktop dev",
    "start:desktop": "pnpm build && pnpm --filter @vanstack/desktop start",
    "build": "pnpm --filter @vanstack/shared --filter @vanstack/xml --filter @vanstack/lowcode-runtime build && pnpm -r --filter @vanstack/backend --filter @vanstack/frontend-editor-server --filter @vanstack/frontend-editor build",
    "build:packages": "pnpm --filter @vanstack/shared --filter @vanstack/xml --filter @vanstack/lowcode-runtime build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "bcrypt", "esbuild", "electron"]
  }
}
